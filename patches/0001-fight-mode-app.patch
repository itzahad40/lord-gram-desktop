+    // ---------------------------------------------------------------- logic (the listeners only call these methods)
+
+    private void collapsePanel() {
+        if (collapseListener != null) {
+            collapseListener.run();
+        }
+    }
+
+    private void toggleMic() {
+        VoIPService service = VoIPService.getSharedInstance();
+        if (service != null) {
+            service.setMicMute(!service.isMicMute(), false, true);
+            refresh();
+        }
+    }
+
+    private void togglePanel(int which) {
+        openPanel = openPanel == which ? 0 : which;
+        presetBox.setVisibility(GONE);
+        slidersBox.setVisibility(VISIBLE);
+        setPanelVisibility();
+    }
+
+    private void setPanelVisibility() {
+        stage.setVisibility(openPanel == 0 ? VISIBLE : GONE);
+        gainPanel.setVisibility(openPanel == 1 ? VISIBLE : GONE);
+        voicePanel.setVisibility(openPanel == 2 ? VISIBLE : GONE);
+        eqPanel.setVisibility(openPanel == 3 ? VISIBLE : GONE);
+        inputPanel.setVisibility(openPanel == 4 ? VISIBLE : GONE);
+        gainTile.setSelectedTile(openPanel == 1);
+        voiceTile.setSelectedTile(openPanel == 2);
+        eqTile.setSelectedTile(openPanel == 3);
+        inputTile.setSelectedTile(openPanel == 4);
+    }
+
+    private void togglePresetList() {
+        boolean show = presetBox.getVisibility() != VISIBLE;
+        presetBox.setVisibility(show ? VISIBLE : GONE);
+        slidersBox.setVisibility(show ? GONE : VISIBLE);
+    }
+
+    private void pushToNative() {
+        VoIPService service = VoIPService.getSharedInstance();
+        if (service != null) {
+            service.applyFightMode();
+        }
+    }
+
+    private void onGainChanged(float db) {
+        FightMode.gainDb = Math.min(Math.max(Math.round(db), 0), FightMode.MAX_GAIN_DB);
+        updateGainViews();
+        pushToNative();
+    }
+
+    private void onGainPreset(int db) {
+        FightMode.gainDb = db;
+        updateGainViews();
+        FightMode.save();
+        pushToNative();
+    }
+
+    private void onVolumeChanged(float value) {
+        FightMode.volume = value;
+        updateVolumeLabel();
+        pushToNative();
+    }
+
+    private void onClarityChanged(float value) {
+        FightMode.clarity = value;
+        updateVoiceViews();
+        pushToNative();
+    }
+
+    private void onPunchChanged(float value) {
+        FightMode.punch = value;
+        updateVoiceViews();
+        pushToNative();
+    }
+
+    private void onVoiceStyle(int index) {
+        FightMode.applyVoice(index);
+        syncFromSettings();
+        FightMode.save();
+        pushToNative();
+    }
+
+    private void onEqBandChanged(int band, float value) {
+        FightMode.eqDb[band] = Math.round(value * 2f * FightMode.MAX_EQ_DB - FightMode.MAX_EQ_DB);
+        updateEqTexts();
+        pushToNative();
+    }
+
+    private void onEqPreset(int index) {
+        FightMode.applyPreset(index);
+        presetBox.setVisibility(GONE);
+        slidersBox.setVisibility(VISIBLE);
+        syncFromSettings();
+        FightMode.save();
+        pushToNative();
+    }
+
+    private void onInputChosen(int index) {
+        FightMode.inputIndex = index;
+        FightMode.save();
+        FightMode.applyInput(true);
+        updateInputViews();
+    }
+
+    private void syncFromSettings() {
+        updateGainViews();
+        updateVolumeLabel();
+        updateVoiceViews();
+        updateEqTexts();
+        updateInputViews();
+        volumeSlider.setValue(FightMode.volume);
+        for (int i = 0; i < FightMode.BANDS; i++) {
+            eqSliders[i].setValue((FightMode.eqDb[i] + FightMode.MAX_EQ_DB) / (2f * FightMode.MAX_EQ_DB));
+        }
+    }
+
+    private void updateGainViews() {
+        gainTile.setValue(String.format(Locale.US, "%ddB", Math.round(FightMode.gainDb)));
+        knob.setValue(FightMode.gainDb / FightMode.MAX_GAIN_DB);
+        gainSlider.setValue(FightMode.gainDb / FightMode.MAX_GAIN_DB);
+    }
+
+    private void updateVolumeLabel() {
+        volumeLabel.setText(String.format(Locale.US, "%d%%", Math.round(FightMode.volume * 100f)));
+    }
+
+    private void updateVoiceViews() {
+        claritySlider.setValue(FightMode.clarity);
+        punchSlider.setValue(FightMode.punch);
+        clarityValue.setText(String.format(Locale.US, "%d%%", Math.round(FightMode.clarity * 100f)));
+        punchValue.setText(String.format(Locale.US, "%d%%", Math.round(FightMode.punch * 100f)));
+        int style = FightMode.matchingVoice();
+        voiceTile.setValue(style >= 0 ? FightMode.VOICE_NAMES[style] : LocaleController.getString(R.string.FightModeCustom));
+    }
+
+    private void updateEqTexts() {
+        for (int i = 0; i < FightMode.BANDS; i++) {
+            eqValues[i].setText(String.format(Locale.US, "%d db", Math.round(FightMode.eqDb[i])));
+        }
+        int preset = FightMode.matchingPreset();
+        eqTile.setValue(preset >= 0 ? FightMode.PRESET_NAMES[preset] : LocaleController.getString(R.string.FightModeCustom));
+    }
+
+    private void updateInputViews() {
+        for (int i = 0; i < inputMarks.length; i++) {
+            boolean on = i == FightMode.inputIndex;
+            inputMarks[i].setText(on ? "\u25CF" : "\u25CB");
+            inputMarks[i].setTextColor(on ? CYAN : SUB);
+        }
+        inputTile.setValue(FightMode.INPUT_NAMES[FightMode.inputIndex]);
+    }
+
+    private void tick() {
+        VoIPService service = VoIPService.getSharedInstance();
+        float level = service != null ? service.getFightModeLevel() : 0f;
+        shownLevel = Math.max(level, shownLevel * 0.82f);
+        micArt.setLevel(shownLevel);
+        led.setLevel(shownLevel);
+        refresh();
+    }
+
+    /** Updates the live / muted look from the real mic state. */
+    public void refresh() {
+        VoIPService service = VoIPService.getSharedInstance();
+        boolean live = service != null && !service.isMicMute();
+        micArt.setLive(live);
+        dot.setLive(live);
+        status.setText(LocaleController.getString(live ? R.string.FightModeMicLive : R.string.FightModeMicMuted));
+        status.setTextColor(live ? HOT : SUB);
+    }
