+    /** Horizontal or vertical slider with a dark track and a cyan fill. value is 0..1. */
+    private static class SliderView extends View {
+        interface Listener {
+            void onChanged(float value, boolean fromUser);
+
+            void onStop();
+        }
+
+        private final boolean vertical;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private float value;
+        private Listener listener;
+
+        SliderView(Context context, boolean vertical) {
+            super(context);
+            this.vertical = vertical;
+            p.setStrokeCap(Paint.Cap.ROUND);
+        }
+
+        void setListener(Listener l) {
+            listener = l;
+        }
+
+        void setValue(float v) {
+            value = Math.min(Math.max(v, 0f), 1f);
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            float pad = dp(12);
+            float w = getWidth(), h = getHeight();
+            float x0, y0, x1, y1, tx, ty;
+            if (vertical) {
+                x0 = x1 = w / 2f;
+                y0 = h - pad;
+                y1 = pad;
+                tx = x0;
+                ty = y0 + (y1 - y0) * value;
+            } else {
+                y0 = y1 = h / 2f;
+                x0 = pad;
+                x1 = w - pad;
+                ty = y0;
+                tx = x0 + (x1 - x0) * value;
+            }
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(dp(4));
+            p.setColor(0xFF263148);
+            c.drawLine(x0, y0, x1, y1, p);
+            p.setColor(CYAN);
+            c.drawLine(x0, y0, tx, ty, p);
+            p.setStyle(Paint.Style.FILL);
+            p.setColor(CYAN);
+            p.setAlpha(70);
+            c.drawCircle(tx, ty, dp(12), p);
+            p.setAlpha(255);
+            p.setColor(TEXT);
+            c.drawCircle(tx, ty, dp(8), p);
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        @Override
+        public boolean onTouchEvent(MotionEvent e) {
+            switch (e.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    if (getParent() != null) {
+                        getParent().requestDisallowInterceptTouchEvent(true);
+                    }
+                    update(e);
+                    return true;
+                case MotionEvent.ACTION_MOVE:
+                    update(e);
+                    return true;
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    update(e);
+                    if (listener != null) {
+                        listener.onStop();
+                    }
+                    return true;
+            }
+            return super.onTouchEvent(e);
+        }
+
+        private void update(MotionEvent e) {
+            float pad = dp(12);
+            float v;
+            if (vertical) {
+                v = (getHeight() - pad - e.getY()) / Math.max(1f, getHeight() - 2 * pad);
+            } else {
+                v = (e.getX() - pad) / Math.max(1f, getWidth() - 2 * pad);
+            }
+            value = Math.min(Math.max(v, 0f), 1f);
+            invalidate();
+            if (listener != null) {
+                listener.onChanged(value, true);
+            }
+        }
+    }
+
+    /** Vertical LED level meter (green, amber, red) with a peak marker: shows the boosted mic level. */
+    private static class LedMeter extends View {
+        private static final int SEGMENTS = 16;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+        private float level;
+        private float peak;
+
+        LedMeter(Context context) {
+            super(context);
+        }
+
+        void setLevel(float l) {
+            level = Math.min(Math.max(l, 0f), 1f);
+            peak = Math.max(level, peak - 0.025f);
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            float w = getWidth(), h = getHeight();
+            float gap = dp(2);
+            float segH = (h - gap * (SEGMENTS - 1)) / SEGMENTS;
+            int peakIndex = Math.min(SEGMENTS - 1, (int) (peak * SEGMENTS));
+            for (int i = 0; i < SEGMENTS; i++) {
+                float frac = (i + 1f) / SEGMENTS;
+                int color = frac < 0.62f ? GREEN : (frac < 0.85f ? AMBER : HOT);
+                boolean lit = level * SEGMENTS > i;
+                p.setColor(color);
+                p.setAlpha(lit || (i == peakIndex && peak > 0.03f) ? 255 : 45);
+                float bottom = h - i * (segH + gap);
+                rect.set(0, bottom - segH, w, bottom);
+                c.drawRoundRect(rect, dp(2), dp(2), p);
+            }
+            p.setAlpha(255);
+        }
+    }
+}
