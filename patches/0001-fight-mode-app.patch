+package org.telegram.messenger.voip;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.webrtc.voiceengine.WebRtcAudioRecord;
+
+/**
+ * Lord Gram: settings of "Fight mode" (loud, clear PA-style microphone). Persisted across app restarts.
+ * Whether fight mode is currently ON lives in {@link VoIPService}, so it always starts OFF in a new call.
+ */
+public final class FightMode {
+
+    public static final int BANDS = 6;
+    public static final int[] EQ_FREQ = {60, 400, 1000, 2500, 6300, 16000};
+    public static final float MAX_GAIN_DB = 100f;
+    public static final float MAX_EQ_DB = 12f;
+
+    public static final String[] PRESET_NAMES = {
+            "Flat", "Easy Listening", "Voice", "Bass Boost", "Treble Boost", "Rock",
+            "Pop", "Dance", "Hip Hop", "Jazz", "Classical", "Heavy Metal", "Megaphone"};
+    public static final float[][] PRESETS = {
+            {0, 0, 0, 0, 0, 0},
+            {3, -3, 0, 3, 0, 6},
+            {-6, -3, 2, 5, 3, 0},
+            {8, 5, 0, 0, 0, 0},
+            {0, 0, 0, 4, 7, 9},
+            {5, 3, -2, 2, 4, 5},
+            {-2, 2, 4, 3, -1, -2},
+            {6, 4, 0, 2, 3, 1},
+            {6, 3, -1, 2, 0, 2},
+            {3, 2, -2, 2, 4, 4},
+            {4, 2, -1, -1, 2, 4},
+            {4, 1, -1, 3, 5, 2},
+            {-8, -4, 4, 9, 4, -4},
+    };
+    private static final int MEGAPHONE_EQ = 12;
+
+    /** Voice styles: clarity = presence / less mud, punch = compressor (evens out quiet and loud words),
+     *  broadcast = dynamic de-hiss + harmonic exciter (denser, more "radio" sounding voice). */
+    public static final String[] VOICE_NAMES = {"Natural", "Clear", "Loud & Clear", "Megaphone", "Broadcast"};
+    public static final float[] VOICE_CLARITY = {0f, 0.6f, 0.8f, 1f, 0.9f};
+    public static final float[] VOICE_PUNCH = {0f, 0.4f, 0.7f, 1f, 0.85f};
+    public static final boolean[] VOICE_BROADCAST = {false, false, false, false, true};
+
+    /** Microphone source ("In Channel"): Default / Cam / Voice / Mic / Call. Call is what Telegram uses normally. */
+    public static final String[] INPUT_NAMES = {"Default", "Cam", "Voice", "Mic", "Call"};
+    public static final String[] INPUT_INFO = {
+            "Phone default", "Camcorder mic", "Voice recognition, less processing", "Raw mic, loudest on many phones", "Call mode with echo cancel (normal)"};
+    /** android.media.MediaRecorder.AudioSource: DEFAULT, CAMCORDER, VOICE_RECOGNITION, MIC, VOICE_COMMUNICATION. */
+    public static final int[] INPUT_SOURCES = {0, 5, 6, 1, 7};
+    public static final int NORMAL_INPUT = 4;
+    public static int inputIndex = NORMAL_INPUT;
+
+    public static float gainDb = 24f;
+    public static float volume = 1f;
+    public static float clarity = 0f;
+    public static float punch = 0f;
+    public static boolean broadcast = false;
+    public static final float[] eqDb = new float[BANDS];
+
+    private static boolean loaded;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("lordgram_fightmode", Context.MODE_PRIVATE);
+    }
+
+    public static synchronized void load() {
+        if (loaded) {
+            return;
+        }
+        loaded = true;
+        SharedPreferences p = prefs();
+        gainDb = clamp(p.getFloat("gainDb", 24f), 0f, MAX_GAIN_DB);
+        volume = clamp(p.getFloat("volume", 1f), 0f, 1f);
+        inputIndex = Math.min(Math.max(p.getInt("inputIndex", NORMAL_INPUT), 0), INPUT_NAMES.length - 1);
+        clarity = clamp(p.getFloat("clarity", 0f), 0f, 1f);
+        punch = clamp(p.getFloat("punch", 0f), 0f, 1f);
+        broadcast = p.getBoolean("broadcast", false);
+        for (int i = 0; i < BANDS; i++) {
+            eqDb[i] = clamp(p.getFloat("eq" + i, 0f), -MAX_EQ_DB, MAX_EQ_DB);
+        }
+    }
+
+    public static synchronized void save() {
+        SharedPreferences.Editor e = prefs().edit();
+        e.putInt("inputIndex", inputIndex);
+        e.putFloat("gainDb", gainDb).putFloat("volume", volume).putFloat("clarity", clarity).putFloat("punch", punch).putBoolean("broadcast", broadcast);
+        for (int i = 0; i < BANDS; i++) {
+            e.putFloat("eq" + i, eqDb[i]);
+        }
+        e.apply();
+    }
+
+    /** 9 values for the native side: 6 EQ bands, clarity, punch, broadcast (0/1). */
+    public static float[] toNative() {
+        float[] out = new float[BANDS + 3];
+        System.arraycopy(eqDb, 0, out, 0, BANDS);
+        out[BANDS] = clarity;
+        out[BANDS + 1] = punch;
+        out[BANDS + 2] = broadcast ? 1f : 0f;
+        return out;
+    }
+
+    /** Index of the preset equal to the current EQ, or -1 for "Custom". */
+    public static int matchingPreset() {
+        for (int p = 0; p < PRESETS.length; p++) {
+            boolean same = true;
+            for (int i = 0; i < BANDS; i++) {
+                if (Math.abs(PRESETS[p][i] - eqDb[i]) > 0.01f) {
+                    same = false;
+                    break;
+                }
+            }
+            if (same) {
+                return p;
+            }
+        }
+        return -1;
+    }
+
+    public static void applyPreset(int index) {
+        System.arraycopy(PRESETS[index], 0, eqDb, 0, BANDS);
+    }
+
+    /** Index of the voice style equal to the current clarity/punch, or -1 for "Custom". */
+    public static int matchingVoice() {
+        for (int i = 0; i < VOICE_NAMES.length; i++) {
+            if (Math.abs(VOICE_CLARITY[i] - clarity) < 0.02f && Math.abs(VOICE_PUNCH[i] - punch) < 0.02f && VOICE_BROADCAST[i] == broadcast) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static final int MEGAPHONE_INDEX = 3;
+
+    public static void applyVoice(int index) {
+        clarity = VOICE_CLARITY[index];
+        punch = VOICE_PUNCH[index];
+        broadcast = VOICE_BROADCAST[index];
+        if (index == MEGAPHONE_INDEX) {
+            applyPreset(MEGAPHONE_EQ); // Megaphone also shapes the EQ: less bass, strong mids
+        }
+    }
+
+    /**
+     * Fight mode ON uses the chosen source, OFF goes back to the normal call source.
+     * Runs on a background thread because the recorder restart waits for its reader thread.
+     */
+    public static void applyInput(boolean fightModeOn) {
+        final int source = INPUT_SOURCES[fightModeOn ? inputIndex : NORMAL_INPUT];
+        new Thread(() -> WebRtcAudioRecord.switchAudioSource(source), "lg-mic-source").start();
+    }
+
+    /** A call ended: the next normal call must not inherit the fight mode source. */
+    public static void onCallEnded() {
+        WebRtcAudioRecord.resetAudioSource();
+    }
+
+    private static float clamp(float v, float lo, float hi) {
+        return Math.min(Math.max(v, lo), hi);
+    }
+
+    private FightMode() {}
+}
