+    /** Rotary gain knob: drag up / down (or tap) to change. value 0..1 maps to 0..100 dB. */
+    private static class KnobView extends View {
+        interface Listener {
+            void onChanged(float value);
+
+            void onStop();
+        }
+
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint t = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+        private float value;
+        private float downY, startValue;
+        private Listener listener;
+
+        KnobView(Context context) {
+            super(context);
+            p.setStrokeCap(Paint.Cap.ROUND);
+            t.setTextAlign(Paint.Align.CENTER);
+            t.setTypeface(Typeface.DEFAULT_BOLD);
+        }
+
+        void setListener(Listener l) {
+            listener = l;
+        }
+
+        void setValue(float v) {
+            value = Math.min(Math.max(v, 0f), 1f);
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            float cx = getWidth() / 2f, cy = getHeight() / 2f;
+            float r = Math.min(getWidth(), getHeight()) / 2f - dp(10);
+            rect.set(cx - r, cy - r, cx + r, cy + r);
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(dp(10));
+            p.setShader(null);
+            p.setColor(0xFF222B3D);
+            c.drawArc(rect, 135, 270, false, p);
+            if (value > 0.004f) {
+                p.setShader(new LinearGradient(cx - r, cy + r, cx + r, cy - r, CYAN, VIOLET, Shader.TileMode.CLAMP));
+                c.drawArc(rect, 135, 270 * value, false, p);
+                p.setShader(null);
+            }
+            double a = Math.toRadians(135 + 270 * value);
+            p.setStyle(Paint.Style.FILL);
+            p.setColor(TEXT);
+            c.drawCircle(cx + (float) Math.cos(a) * r, cy + (float) Math.sin(a) * r, dp(7), p);
+            p.setColor(0xFF0F1522);
+            c.drawCircle(cx, cy, r - dp(16), p);
+            t.setColor(TEXT);
+            t.setTextSize(dp(34));
+            c.drawText(String.valueOf(Math.round(value * FightMode.MAX_GAIN_DB)), cx, cy + dp(8), t);
+            t.setColor(SUB);
+            t.setTextSize(dp(12));
+            c.drawText("dB  GAIN", cx, cy + dp(26), t);
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        @Override
+        public boolean onTouchEvent(MotionEvent e) {
+            switch (e.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    if (getParent() != null) {
+                        getParent().requestDisallowInterceptTouchEvent(true);
+                    }
+                    downY = e.getY();
+                    startValue = value;
+                    return true;
+                case MotionEvent.ACTION_MOVE: {
+                    float delta = (downY - e.getY()) / dp(280);
+                    value = Math.min(Math.max(startValue + delta, 0f), 1f);
+                    invalidate();
+                    if (listener != null) {
+                        listener.onChanged(value);
+                    }
+                    return true;
+                }
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    if (listener != null) {
+                        listener.onStop();
+                    }
+                    return true;
+            }
+            return super.onTouchEvent(e);
+        }
+    }
