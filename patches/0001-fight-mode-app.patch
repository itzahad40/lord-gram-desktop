+  // ---- Lord Gram: change the microphone source (Default / Cam / Voice / Mic / Call) while a call is running ----
+  private static volatile WebRtcAudioRecord micInstance;
+
+  /** The source used for the next (re)start of the recorder. */
+  public static int getAudioSource() {
+    return audioSource;
+  }
+
+  /** Back to the normal call source (VOICE_COMMUNICATION). Used when a call ends. */
+  public static void resetAudioSource() {
+    audioSource = DEFAULT_AUDIO_SOURCE;
+  }
+
+  /**
+   * Switches the source now if the microphone is recording (about 0.2 s of silence, the mute state is kept),
+   * otherwise only remembers it for the next start. Blocks for a short moment: call it from a background thread.
+   * Returns true when the running recorder now uses the new source.
+   */
+  public static boolean switchAudioSource(int source) {
+    WebRtcAudioRecord rec = micInstance;
+    if (rec == null) {
+      audioSource = source;
+      return false;
+    }
+    return rec.switchSourceInternal(source);
+  }
+
+  private synchronized boolean switchSourceInternal(int source) {
+    if (captureType != 0 || audioRecord == null || audioThread == null) {
+      audioSource = source; // not recording right now: it is used at the next init
+      return false;
+    }
+    if (audioSource == source) {
+      return true;
+    }
+    final int oldSource = audioSource;
+    Logging.w(TAG, "switching microphone source " + oldSource + " -> " + source);
+
+    // stop the reader thread and the old AudioRecord
+    audioThread.stopThread();
+    if (!ThreadUtils.joinUninterruptibly(audioThread, AUDIO_RECORD_THREAD_JOIN_TIMEOUT_MS)) {
+      Logging.e(TAG, "Join of AudioRecordJavaThread timed out");
+    }
+    audioThread = null;
+    try {
+      audioRecord.stop();
+    } catch (Throwable e) {
+      FileLog.e(e);
+    }
+    if (effects != null) {
+      effects.release();
+    }
+    releaseAudioResources(false);
+
+    if (createMicRecord(source) && startRecording()) {
+      audioSource = source;
+      return true;
+    }
+
+    // the new source did not work on this phone: go back, so the call never loses its microphone
+    releaseAudioResources(false);
+    if (createMicRecord(oldSource)) {
+      startRecording();
+    }
+    audioSource = oldSource;
+    return false;
+  }
+
+  private boolean createMicRecord(int source) {
+    final int channelConfig = channelCountToConfiguration(requestedChannels);
+    int minBufferSize =
+        AudioRecord.getMinBufferSize(requestedSampleRate, channelConfig, AudioFormat.ENCODING_PCM_16BIT);
+    if (minBufferSize == AudioRecord.ERROR || minBufferSize == AudioRecord.ERROR_BAD_VALUE) {
+      return false;
+    }
+    int bufferSizeInBytes = Math.max(BUFFER_SIZE_FACTOR * minBufferSize, byteBuffer.capacity());
+    try {
+      audioRecord = new AudioRecord(source, requestedSampleRate, channelConfig,
+              AudioFormat.ENCODING_PCM_16BIT, bufferSizeInBytes);
+    } catch (IllegalArgumentException | SecurityException e) {
+      FileLog.e(e);
+      audioRecord = null;
+      return false;
+    }
+    if (audioRecord.getState() != AudioRecord.STATE_INITIALIZED) {
+      releaseAudioResources(false);
+      return false;
+    }
+    if (effects != null) {
+      effects.enable(audioRecord.getAudioSessionId());
+    }
+    return true;
+  }
