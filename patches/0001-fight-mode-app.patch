+    /** Simple vector icons drawn in code (no image assets). */
+    private static class IconView extends View {
+        static final int MIC = 0, KNOB = 1, VOICE = 2, EQ = 3;
+        private final int type;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+
+        IconView(Context context, int type, int color) {
+            super(context);
+            this.type = type;
+            p.setColor(color);
+            p.setStrokeCap(Paint.Cap.ROUND);
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            float cx = getWidth() / 2f, cy = getHeight() / 2f;
+            float r = Math.min(getWidth(), getHeight()) / 2f - dp(1);
+            p.setStrokeWidth(Math.max(dp(2), r * 0.14f));
+            p.setStyle(Paint.Style.STROKE);
+            switch (type) {
+                case KNOB: {
+                    c.drawCircle(cx, cy, r * 0.62f, p);
+                    c.drawLine(cx, cy, cx + r * 0.38f, cy - r * 0.38f, p);
+                    for (int i = 0; i <= 8; i++) {
+                        double a = Math.toRadians(-135 + i * 33.75);
+                        c.drawLine(cx + (float) Math.sin(a) * r * 0.84f, cy - (float) Math.cos(a) * r * 0.84f,
+                                cx + (float) Math.sin(a) * r, cy - (float) Math.cos(a) * r, p);
+                    }
+                    break;
+                }
+                case VOICE: {
+                    float[] heights = {0.25f, 0.6f, 0.95f, 0.5f, 0.75f, 0.3f};
+                    for (int i = 0; i < heights.length; i++) {
+                        float x = cx - r * 0.85f + i * (r * 1.7f / (heights.length - 1));
+                        c.drawLine(x, cy - r * heights[i] * 0.85f, x, cy + r * heights[i] * 0.85f, p);
+                    }
+                    break;
+                }
+                case EQ: {
+                    float[] xs = {cx - r * 0.6f, cx, cx + r * 0.6f};
+                    float[] ys = {cy - r * 0.3f, cy + r * 0.3f, cy - r * 0.05f};
+                    for (int i = 0; i < 3; i++) {
+                        p.setStyle(Paint.Style.STROKE);
+                        c.drawLine(xs[i], cy - r * 0.85f, xs[i], cy + r * 0.85f, p);
+                        p.setStyle(Paint.Style.FILL);
+                        c.drawCircle(xs[i], ys[i], r * 0.2f, p);
+                    }
+                    break;
+                }
+                default: { // MIC
+                    rect.set(cx - r * 0.3f, cy - r * 0.85f, cx + r * 0.3f, cy + r * 0.1f);
+                    p.setStyle(Paint.Style.FILL);
+                    c.drawRoundRect(rect, r * 0.3f, r * 0.3f, p);
+                    p.setStyle(Paint.Style.STROKE);
+                    rect.set(cx - r * 0.58f, cy - r * 0.5f, cx + r * 0.58f, cy + r * 0.45f);
+                    c.drawArc(rect, 0, 180, false, p);
+                    c.drawLine(cx, cy + r * 0.45f, cx, cy + r * 0.85f, p);
+                    c.drawLine(cx - r * 0.3f, cy + r * 0.85f, cx + r * 0.3f, cy + r * 0.85f, p);
+                }
+            }
+        }
+    }
