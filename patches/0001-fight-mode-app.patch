+package org.telegram.ui.Components.voip;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.view.MotionEvent;
+import android.view.View;
+
+import org.telegram.messenger.voip.VoIPService;
+
+/**
+ * Lord Gram: the round microphone shown while Fight mode is ON (top right).
+ * Tap it to open the full microphone panel. Drag it to move it. It glows with the boosted mic level.
+ * It disappears only when Fight mode is switched off from the 3-dot menu.
+ */
+@SuppressLint("ViewConstructor")
+public class FightModeBubble extends View {
+
+    private static final int BG = 0xFF0B0F17;
+    private static final int ACCENT = 0xFF30D5FF;
+    private static final int LIVE = 0xFFFF3B5C;
+
+    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private final Runnable onTap;
+    private boolean live;
+    private float shownLevel;
+    private float downX, downY, startTx, startTy;
+    private boolean dragging;
+
+    private final Runnable ticker = new Runnable() {
+        @Override
+        public void run() {
+            VoIPService service = VoIPService.getSharedInstance();
+            live = service != null && !service.isMicMute();
+            float level = service != null ? service.getFightModeLevel() : 0f;
+            shownLevel = Math.max(level, shownLevel * 0.82f);
+            invalidate();
+            postDelayed(this, 60);
+        }
+    };
+
+    public FightModeBubble(Context context, Runnable onTap) {
+        super(context);
+        this.onTap = onTap;
+        setElevation(dp(8));
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        removeCallbacks(ticker);
+        post(ticker);
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        removeCallbacks(ticker);
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        float cx = getWidth() / 2f, cy = getHeight() / 2f;
+        float base = dp(20);
+        if (live && shownLevel > 0.02f) {
+            p.setStyle(Paint.Style.FILL);
+            p.setColor(ACCENT);
+            p.setAlpha((int) (110 * Math.min(1f, shownLevel * 1.5f)));
+            c.drawCircle(cx, cy, base + dp(7) * shownLevel, p);
+            p.setAlpha(255);
+        }
+        p.setStyle(Paint.Style.FILL);
+        p.setColor(BG);
+        c.drawCircle(cx, cy, base, p);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeWidth(dp(2));
+        p.setColor(live ? LIVE : ACCENT);
+        c.drawCircle(cx, cy, base, p);
+
+        // microphone glyph
+        int glyph = live ? LIVE : 0xFFFFFFFF;
+        p.setColor(glyph);
+        p.setStyle(Paint.Style.FILL);
+        rect.set(cx - dp(4), cy - dp(11), cx + dp(4), cy + dp(2));
+        c.drawRoundRect(rect, dp(4), dp(4), p);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeCap(Paint.Cap.ROUND);
+        rect.set(cx - dp(8), cy - dp(7), cx + dp(8), cy + dp(6));
+        c.drawArc(rect, 0, 180, false, p);
+        c.drawLine(cx, cy + dp(6), cx, cy + dp(11), p);
+        c.drawLine(cx - dp(4), cy + dp(11), cx + dp(4), cy + dp(11), p);
+        if (!live) {
+            p.setColor(0xFFFFFFFF);
+            c.drawLine(cx - dp(10), cy - dp(10), cx + dp(10), cy + dp(10), p);
+        }
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                downX = e.getRawX();
+                downY = e.getRawY();
+                startTx = getTranslationX();
+                startTy = getTranslationY();
+                dragging = false;
+                if (getParent() != null) {
+                    getParent().requestDisallowInterceptTouchEvent(true);
+                }
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (!dragging && (Math.abs(e.getRawX() - downX) > dp(8) || Math.abs(e.getRawY() - downY) > dp(8))) {
+                    dragging = true;
+                }
+                if (dragging) {
+                    setTranslationX(startTx + (e.getRawX() - downX));
+                    setTranslationY(startTy + (e.getRawY() - downY));
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+                if (!dragging && onTap != null) {
+                    onTap.run();
+                }
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                return true;
+        }
+        return super.onTouchEvent(e);
+    }
+}
