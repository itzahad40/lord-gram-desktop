+    /** The glowing studio microphone. Tap it to go live / mute. Rings pulse with the output level. */
+    private static class MicArtView extends View {
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+        private boolean live;
+        private float level;
+        private float phase;
+
+        MicArtView(Context context) {
+            super(context);
+            setClickable(true);
+        }
+
+        void setLive(boolean live) {
+            if (this.live != live) {
+                this.live = live;
+                invalidate();
+            }
+        }
+
+        void setLevel(float level) {
+            this.level = level;
+            phase = (phase + 0.012f + level * 0.05f) % 1f;
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            // virtual canvas 200 x 262
+            float s = Math.min(getWidth() / 200f, getHeight() / 262f);
+            c.save();
+            c.translate((getWidth() - 200f * s) / 2f, (getHeight() - 262f * s) / 2f);
