+
+            int accent = live ? CYAN : 0xFF5C6678;
+            int accentDark = live ? 0xFF0C4A6E : 0xFF2A313D;
+
+            if (live) {
+                for (int k = 0; k < 3; k++) {
+                    float ph = (phase + k / 3f) % 1f;
+                    float rr = 50f + ph * 62f;
+                    int alpha = (int) (170f * (1f - ph) * Math.min(1f, 0.25f + level * 1.8f));
+                    p.setStyle(Paint.Style.STROKE);
+                    p.setStrokeWidth(2.5f);
+                    p.setColor(accent);
+                    p.setAlpha(Math.max(0, Math.min(255, alpha)));
+                    c.drawCircle(100, 80, rr, p);
+                }
+                p.setAlpha(255);
+                float gr = 80f + 40f * level;
+                p.setStyle(Paint.Style.FILL);
+                p.setShader(new RadialGradient(100, 80, gr, new int[]{0x553DD5FF, 0x00000000}, null, Shader.TileMode.CLAMP));
+                c.drawCircle(100, 80, gr, p);
+                p.setShader(null);
+            }
+
+            // stand and base
+            p.setStyle(Paint.Style.FILL);
+            p.setColor(0xFF3A4455);
+            rect.set(95, 168, 105, 220);
+            c.drawRoundRect(rect, 4, 4, p);
+            p.setShader(new LinearGradient(40, 0, 160, 0, new int[]{accentDark, accent, accentDark}, null, Shader.TileMode.CLAMP));
+            rect.set(42, 212, 158, 238);
+            c.drawOval(rect, p);
+            p.setShader(null);
+            p.setColor(0xFF0B0F17);
+            rect.set(54, 216, 146, 232);
+            c.drawOval(rect, p);
+
+            // holder
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(5);
+            p.setStrokeCap(Paint.Cap.ROUND);
+            p.setColor(0xFF566177);
+            rect.set(52, 66, 148, 168);
+            c.drawArc(rect, 8, 164, false, p);
+
+            // head: steel capsule with mesh
+            p.setStyle(Paint.Style.FILL);
+            p.setShader(new LinearGradient(62, 0, 138, 0, new int[]{0xFF222A38, 0xFF7C8BA3, 0xFF222A38}, null, Shader.TileMode.CLAMP));
+            rect.set(62, 20, 138, 130);
+            c.drawRoundRect(rect, 38, 38, p);
+            p.setShader(null);
+            c.save();
+            c.clipRect(62, 20, 138, 130);
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(1.5f);
+            p.setColor(0xFFC9D4E8);
+            p.setAlpha(110);
+            for (float y = 32; y < 130; y += 9) {
+                c.drawLine(62, y, 138, y, p);
+            }
+            for (float x = 70; x < 138; x += 9) {
+                c.drawLine(x, 20, x, 130, p);
+            }
+            p.setAlpha(255);
+            c.restore();
+
+            // neon ring and neck
+            p.setStyle(Paint.Style.FILL);
+            p.setColor(accent);
+            rect.set(66, 124, 134, 136);
+            c.drawRoundRect(rect, 6, 6, p);
+            p.setColor(0xFF2A3345);
+            rect.set(80, 136, 120, 160);
+            c.drawRoundRect(rect, 6, 6, p);
