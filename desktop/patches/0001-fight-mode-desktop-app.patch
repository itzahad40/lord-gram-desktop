+
+std::vector<float> FightModeSettings::packed() const {
+	auto result = std::vector<float>();
+	result.reserve(9);
+	for (const auto value : eqDb) {
+		result.push_back(value);
+	}
+	result.push_back(clarity);
+	result.push_back(punch);
+	result.push_back(broadcast ? 1.f : 0.f);
+	return result;
+}
+
+FightModeSettings LoadFightModeSettings() {
+	auto result = FightModeSettings();
+	auto file = QSettings(SettingsPath(), QSettings::IniFormat);
+	result.gainDb = Clamped(
+		file.value(u"gainDb"_q, 0.).toFloat(),
+		0.f,
+		kMaxGainDb);
+	result.volume = Clamped(file.value(u"volume"_q, 1.).toFloat(), 0.f, 1.f);
+	for (auto i = 0; i != kEqBands; ++i) {
+		result.eqDb[i] = Clamped(
+			file.value(u"eq%1"_q.arg(i), 0.).toFloat(),
+			-kMaxEqDb,
+			kMaxEqDb);
+	}
+	result.clarity = Clamped(file.value(u"clarity"_q, 0.).toFloat(), 0.f, 1.f);
+	result.punch = Clamped(file.value(u"punch"_q, 0.).toFloat(), 0.f, 1.f);
+	result.broadcast = file.value(u"broadcast"_q, false).toBool();
+	return result;
+}
+
+void SaveFightModeSettings(const FightModeSettings &settings) {
+	auto file = QSettings(SettingsPath(), QSettings::IniFormat);
+	file.setValue(u"gainDb"_q, settings.gainDb);
+	file.setValue(u"volume"_q, settings.volume);
+	for (auto i = 0; i != kEqBands; ++i) {
+		file.setValue(u"eq%1"_q.arg(i), settings.eqDb[i]);
+	}
+	file.setValue(u"clarity"_q, settings.clarity);
+	file.setValue(u"punch"_q, settings.punch);
+	file.setValue(u"broadcast"_q, settings.broadcast);
+	file.sync();
+}
+
+FightModeSettings &FightModeShared() {
+	static auto result = LoadFightModeSettings();
+	return result;
+}
+
+void ApplyFightMode() {
+	if (const auto call = Core::App().calls().currentGroupCall()) {
+		call->setFightMode(FightModeShared());
+	}
+}
+
+rpl::producer<QString> FightModeMenuLabel() {
+	return rpl::make_producer<QString>([=](const auto &consumer) {
+		auto lifetime = rpl::lifetime();
+		const auto timer = lifetime.make_state<base::Timer>();
+		const auto phase = lifetime.make_state<bool>(false);
+		const auto push = [=] {
+			if (!FightModeShared().enabled) {
+				consumer.put_next(u"Fight mode"_q);
+				return;
+			}
+			*phase = !*phase;
+			consumer.put_next(*phase
+				? u"Fight mode  \u25CF"_q
+				: u"Fight mode  \u25CB"_q);
+		};
+		timer->setCallback(push);
+		timer->callEach(kBlinkInterval);
+		push();
+		return lifetime;
+	});
+}
