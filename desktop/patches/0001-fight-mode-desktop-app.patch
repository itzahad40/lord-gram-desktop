+void FightModeBox(not_null<Ui::GenericBox*> box) {
+	struct State {
+		FightModeSettings settings;
+		std::array<float, kBars> history = {};
+		QString levelText = u"-- dB"_q;
+		QImage logo = QImage(u":/gui/art/lordgram_fight.png"_q);
+		SetValue gain;
+		SetValue master;
+		SetValue clarity;
+		std::vector<SetValue> eq;
+		rpl::variable<QString> powerText;
+		rpl::variable<QString> broadcastText;
+		base::Timer timer;
+	};
+	const auto state = box->lifetime().make_state<State>();
+	state->settings = FightModeShared();
+
+	const auto apply = [=] {
+		FightModeShared() = state->settings;
+		ApplyFightMode();
+	};
+	const auto save = [=] {
+		SaveFightModeSettings(state->settings);
+	};
+	const auto refreshTexts = [=] {
+		state->powerText = state->settings.enabled
+			? u"FIGHT MODE: ON"_q
+			: u"FIGHT MODE: OFF"_q;
+		state->broadcastText = state->settings.broadcast
+			? u"BROADCAST: ON"_q
+			: u"BROADCAST: OFF"_q;
+	};
+	refreshTexts();
+
+	const auto pad = st::groupCallFightModePadding;
+	const auto gap = st::groupCallFightModeGap;
+	const auto fullWidth = st::groupCallFightModeWidth;
+	const auto panelHeight = st::groupCallFightModeHeight - 2 * pad;
+	const auto leftWidth = st::groupCallFightModeLeftWidth;
+	const auto rightLeft = pad + leftWidth + gap;
+	const auto rightWidth = fullWidth - pad - rightLeft;
+
+	box->setWidth(fullWidth);
+	box->setNoContentMargin(true);
+	const auto root = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		style::margins());
+	root->resize(fullWidth, st::groupCallFightModeHeight);
+
+	const auto left = Ui::CreateChild<Ui::RpWidget>(root);
+	left->setGeometry(pad, pad, leftWidth, panelHeight);
+	const auto right = Ui::CreateChild<Ui::RpWidget>(root);
+	right->setGeometry(rightLeft, pad, rightWidth, panelHeight);
+
+	const auto logoSize = st::groupCallFightModeLogoSize;
+	const auto logoTop = st::groupCallFightModeLogoTop;
+	const auto titleTop = logoTop + logoSize + gap;
+	const auto subtitleTop = titleTop + st::groupCallFightModeTitleHeight;
+	const auto powerTop = subtitleTop
+		+ st::groupCallFightModeSubtitleHeight
+		+ gap;
+	const auto spectrumHeight = st::groupCallFightModeSpectrumHeight;
+	const auto spectrumRect = QRect(
+		pad,
+		panelHeight - pad - spectrumHeight,
+		leftWidth - 2 * pad,
+		spectrumHeight);
+
+	left->paintOn([=](QPainter &p) {
+		PaintCard(p, left->rect());
+		auto hq = PainterHighQualityEnabler(p);
+		const auto center = QPointF(
+			left->width() / 2.,
+			logoTop + logoSize / 2.);
+		auto glow = QRadialGradient(center, logoSize * 0.75);
+		glow.setColorAt(0., QColor(255, 31, 61, 110));
+		glow.setColorAt(1., QColor(255, 31, 61, 0));
+		p.setPen(Qt::NoPen);
+		p.setBrush(glow);
+		p.drawEllipse(center, logoSize * 0.75, logoSize * 0.75);
+
+		const auto logoRect = QRectF(
+			center.x() - logoSize / 2.,
+			logoTop,
+			logoSize,
+			logoSize);
+		if (!state->logo.isNull()) {
+			auto path = QPainterPath();
+			path.addEllipse(logoRect);
+			p.save();
+			p.setClipPath(path);
+			p.drawImage(logoRect, state->logo);
+			p.restore();
+		}
+		const auto ring = st::groupCallFightModeRingWidth;
+		p.setPen(QPen(kRed, ring));
+		p.setBrush(Qt::NoBrush);
+		p.drawEllipse(logoRect.adjusted(
+			ring / 2.,
+			ring / 2.,
+			-ring / 2.,
+			-ring / 2.));
+
+		const auto titleRect = QRect(
+			0,
+			titleTop,
+			left->width(),
+			st::groupCallFightModeTitleHeight);
+		const auto title = u"LORD'S GRAM"_q;
+		p.setFont(st::groupCallFightModeTitleFont->f);
+		const auto glowShift = st::groupCallFightModeGlow;
+		p.setPen(QColor(255, 31, 61, 70));
+		for (const auto &shift : {
+			QPoint(-glowShift, 0),
+			QPoint(glowShift, 0),
+			QPoint(0, -glowShift),
+			QPoint(0, glowShift),
+		}) {
+			p.drawText(titleRect.translated(shift), Qt::AlignCenter, title);
+		}
+		p.setPen(kRedBright);
+		p.drawText(titleRect, Qt::AlignCenter, title);
+
+		auto subtitleFont = st::groupCallFightModeSmallFont->f;
+		subtitleFont.setLetterSpacing(
+			QFont::AbsoluteSpacing,
+			st::groupCallFightModeSubtitleSpacing);
+		p.setFont(subtitleFont);
+		p.setPen(kText);
+		p.drawText(
+			QRect(
+				0,
+				subtitleTop,
+				left->width(),
+				st::groupCallFightModeSubtitleHeight),
+			Qt::AlignCenter,
+			u"FIGHT MODE"_q);
+
+		PaintCard(p, spectrumRect);
+		p.setFont(st::groupCallFightModeSmallFont->f);
+		const auto headerRect = QRect(
+			spectrumRect.x() + gap,
+			spectrumRect.y(),
+			spectrumRect.width() - 2 * gap,
+			st::groupCallFightModeSpectrumHeader);
+		p.setPen(kMuted);
+		p.drawText(
+			headerRect,
+			Qt::AlignLeft | Qt::AlignVCenter,
+			u"LIVE MIC LEVEL"_q);
+		p.setPen(kOrange);
+		p.drawText(
+			headerRect,
+			Qt::AlignRight | Qt::AlignVCenter,
+			state->levelText);
+
+		const auto barWidth = st::groupCallFightModeBarWidth;
+		const auto barGap = st::groupCallFightModeBarGap;
+		const auto area = QRect(
+			spectrumRect.x() + gap,
+			spectrumRect.y() + st::groupCallFightModeSpectrumHeader,
+			spectrumRect.width() - 2 * gap,
+			spectrumRect.height()
+				- st::groupCallFightModeSpectrumHeader
+				- gap);
+		auto gradient = QLinearGradient(
+			QPointF(0, area.bottom()),
+			QPointF(0, area.top()));
+		gradient.setColorAt(0., kRed);
+		gradient.setColorAt(1., kOrange);
+		p.setPen(Qt::NoPen);
+		p.setBrush(gradient);
+		const auto step = barWidth + barGap;
+		const auto barsLeft = area.x()
+			+ (area.width() - (kBars * step - barGap)) / 2;
+		for (auto i = 0; i != kBars; ++i) {
+			const auto shaped = std::sqrt(state->history[i]);
+			const auto height = std::max(
+				int(base::SafeRound(shaped * area.height())),
+				int(st::groupCallFightModeBarMinHeight));
+			p.drawRect(
+				barsLeft + i * step,
+				area.bottom() + 1 - height,
+				barWidth,
+				height);
+		}
+	});
+
+	AddButton(
+		left,
+		QRect(
+			pad,
+			powerTop,
+			leftWidth - 2 * pad,
+			st::groupCallFightModeButtonHeight),
+		state->powerText.value(),
+		ButtonKind::Primary,
+		[=] { return state->settings.enabled; },
+		[=] {
+			state->settings.enabled = !state->settings.enabled;
+			refreshTexts();
+			apply();
+		});
+
+	right->paintOn([=](QPainter &p) {
+		PaintCard(p, right->rect());
+		auto hq = PainterHighQualityEnabler(p);
+		const auto markTop = (st::groupCallFightModeHeaderHeight
+			- st::groupCallFightModeHeaderMarkHeight) / 2;
+		p.setPen(Qt::NoPen);
+		p.setBrush(kRed);
+		p.drawRect(
+			pad,
+			markTop,
+			st::groupCallFightModeHeaderMarkWidth,
+			st::groupCallFightModeHeaderMarkHeight);
+		p.setFont(st::groupCallFightModeLabelFont->f);
+		p.setPen(kRedBright);
+		p.drawText(
+			QRect(
+				pad + st::groupCallFightModeHeaderMarkWidth + gap / 2,
+				0,
+				right->width() - 2 * pad,
+				st::groupCallFightModeHeaderHeight),
+			Qt::AlignLeft | Qt::AlignVCenter,
+			u"LIVE EFFECT RACK  -  9 CONTROLS"_q);
+		p.setFont(st::groupCallFightModeSmallFont->f);
+		p.setPen(kOrange);
+		p.drawText(
+			QRect(
+				pad,
+				right->height() - pad - st::groupCallFightModeTipHeight,
+				right->width() - 2 * pad,
+				st::groupCallFightModeTipHeight),
+			Qt::AlignLeft | Qt::AlignVCenter,
+			u"Tip: voice phat-ti ho to GAIN kam karo (20 dB se upar clip hota hai). Headset use karo."_q);
+	});
+
+	const auto columnWidth = (rightWidth - 2 * pad - gap) / 2;
+	const auto rowsTop = st::groupCallFightModeHeaderHeight;
+	const auto rowRect = [=](int column, int row) {
+		return QRect(
+			pad + column * (columnWidth + gap),
+			rowsTop + row * st::groupCallFightModeRowHeight,
+			columnWidth,
+			st::groupCallFightModeRowHeight);
+	};
+	const auto percent = [](float64 value) {
+		return QString::number(qRound(value * 100.)) + u"%"_q;
+	};
+
+	state->gain = AddRackSlider(
+		right,
+		rowRect(0, 0),
+		u"GAIN / PREAMP"_q,
+		state->settings.gainDb / kMaxGainDb,
+		[](float64 value) {
+			return QString::number(qRound(value * kMaxGainDb)) + u" dB"_q;
+		},
+		[=](float64 value) {
+			state->settings.gainDb = float(value) * kMaxGainDb;
+			apply();
+		},
+		save);
+	state->master = AddRackSlider(
+		right,
+		rowRect(0, 1),
+		u"MASTER OUTPUT"_q,
+		state->settings.volume,
+		percent,
+		[=](float64 value) {
+			state->settings.volume = float(value);
+			apply();
+		},
+		save);
+	state->clarity = AddRackSlider(
+		right,
+		rowRect(0, 2),
+		u"CLARITY"_q,
+		state->settings.clarity,
+		percent,
+		[=](float64 value) {
+			state->settings.clarity = float(value);
+			apply();
+		},
+		save);
+	for (auto i = 0; i != kEqBands; ++i) {
+		const auto slot = i + kRackRowsBeforeEq;
+		const auto column = (slot < kFirstColumnRows) ? 0 : 1;
+		const auto row = (column == 0) ? slot : (slot - kFirstColumnRows);
+		state->eq.push_back(AddRackSlider(
+			right,
+			rowRect(column, row),
+			QString::fromLatin1(kEqTitles[i]),
+			(state->settings.eqDb[i] + kMaxEqDb) / (2. * kMaxEqDb),
+			[](float64 value) {
+				const auto db = value * 2. * kMaxEqDb - kMaxEqDb;
+				return QString::number(db, 'f', 1) + u" dB"_q;
+			},
+			[=](float64 value) {
+				state->settings.eqDb[i] = float(value) * 2.f * kMaxEqDb
+					- kMaxEqDb;
+				apply();
+			},
+			save));
+	}
+
+	const auto applyPreset = [=](
+			float gainDb,
+			float clarity,
+			bool broadcast,
+			std::array<float, kEqBands> eq) {
+		auto &settings = state->settings;
+		settings.gainDb = gainDb;
+		settings.volume = 1.f;
+		settings.clarity = clarity;
+		settings.broadcast = broadcast;
+		settings.eqDb = eq;
+		state->gain(gainDb / kMaxGainDb);
+		state->master(1.);
+		state->clarity(clarity);
+		for (auto i = 0; i != kEqBands; ++i) {
+			state->eq[i]((eq[i] + kMaxEqDb) / (2. * kMaxEqDb));
+		}
+		refreshTexts();
+		apply();
+		save();
+	};
+
+	const auto buttonsTop = panelHeight
+		- pad
+		- st::groupCallFightModeTipHeight
+		- st::groupCallFightModeButtonHeight
+		- gap / 2;
+	const auto buttonWidth = (rightWidth - 2 * pad - 3 * gap / 2) / 4;
+	const auto buttonGap = gap / 2;
+	const auto buttonRect = [=](int index) {
+		return QRect(
+			pad + index * (buttonWidth + buttonGap),
+			buttonsTop,
+			buttonWidth,
+			st::groupCallFightModeButtonHeight);
+	};
+	AddButton(
+		right,
+		buttonRect(0),
+		rpl::single(u"BATTLE PRESET"_q),
+		ButtonKind::Danger,
+		nullptr,
+		[=] {
+			applyPreset(20.f, 0.6f, true, { 4.f, -2.f, 0.f, 4.f, 3.f, 0.f });
+		});
+	AddButton(
+		right,
+		buttonRect(1),
+		rpl::single(u"CLEAN PRESET"_q),
+		ButtonKind::Plain,
+		nullptr,
+		[=] {
+			applyPreset(12.f, 0.3f, false, {});
+		});
+	AddButton(
+		right,
+		buttonRect(2),
+		state->broadcastText.value(),
+		ButtonKind::Plain,
+		[=] { return state->settings.broadcast; },
+		[=] {
+			state->settings.broadcast = !state->settings.broadcast;
+			refreshTexts();
+			apply();
+			save();
+		});
+	AddButton(
+		right,
+		buttonRect(3),
+		rpl::single(u"CLOSE"_q),
+		ButtonKind::Plain,
+		nullptr,
+		[=] { box->closeBox(); });
+
+	state->timer.setCallback([=] {
+		auto level = tgcalls::GroupInstanceCustomImpl::getFightModeLevel();
+		if (!state->settings.enabled) {
+			level = 0.f;
+		}
+		std::move(
+			state->history.begin() + 1,
+			state->history.end(),
+			state->history.begin());
+		state->history.back() = level;
+		state->levelText = (level > 0.0001f)
+			? QString::number(20. * std::log10(level), 'f', 1) + u" dB"_q
+			: u"-- dB"_q;
+		left->update();
+	});
+	state->timer.callEach(kLevelInterval);
+
+	box->boxClosing(
+	) | rpl::on_next(save, box->lifetime());
+}
+
+} // namespace Calls::Group
