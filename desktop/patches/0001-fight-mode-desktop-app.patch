+constexpr auto kMaxGainDb = 100.f;
+constexpr auto kMaxEqDb = 12.f;
+constexpr auto kEqBands = 6;
+constexpr auto kBars = 32;
+constexpr auto kLevelInterval = crl::time(50);
+constexpr auto kBlinkInterval = crl::time(600);
+constexpr auto kFirstColumnRows = 5;
+constexpr auto kRackRowsBeforeEq = 3;
+
+constexpr auto kEqTitles = std::array<const char*, kEqBands>{
+	"BASS  60 Hz",
+	"LOW-MID  400 Hz",
+	"MID  1 kHz",
+	"PRESENCE  2.5 kHz",
+	"SHARPNESS  6.3 kHz",
+	"TREBLE  16 kHz",
+};
+
+const auto kCardBg = QColor(11, 11, 16);
+const auto kPanelBorder = QColor(120, 14, 30);
+const auto kRed = QColor(255, 31, 61);
+const auto kRedBright = QColor(255, 74, 94);
+const auto kOrange = QColor(255, 138, 42);
+const auto kText = QColor(236, 236, 242);
+const auto kMuted = QColor(130, 130, 146);
+const auto kTrack = QColor(42, 42, 54);
+const auto kButtonBg = QColor(26, 26, 36);
+const auto kButtonOver = QColor(40, 40, 54);
+const auto kWhite = QColor(255, 255, 255);
+const auto kInk = QColor(14, 14, 20);
+
+enum class ButtonKind {
+	Primary,
+	Danger,
+	Plain,
+};
+
+using SetValue = Fn<void(float64)>;
+
+[[nodiscard]] QString SettingsPath() {
+	return cWorkingDir() + u"tdata/lordgram_fightmode.ini"_q;
+}
+
+[[nodiscard]] float Clamped(float value, float min, float max) {
+	return std::clamp(value, min, max);
+}
+
+void PaintCard(QPainter &p, const QRect &rect) {
+	auto hq = PainterHighQualityEnabler(p);
+	p.setPen(QPen(kPanelBorder, st::groupCallFightModeBorder));
+	p.setBrush(kCardBg);
+	p.drawRoundedRect(
+		QRectF(rect).adjusted(0.5, 0.5, -0.5, -0.5),
+		st::groupCallFightModeRadius,
+		st::groupCallFightModeRadius);
+}
+
+[[nodiscard]] not_null<Ui::AbstractButton*> AddButton(
+		not_null<Ui::RpWidget*> parent,
+		const QRect &geometry,
+		rpl::producer<QString> text,
+		ButtonKind kind,
+		Fn<bool()> active,
+		Fn<void()> callback) {
+	const auto button = Ui::CreateChild<Ui::AbstractButton>(parent.get());
+	button->setGeometry(geometry);
+	const auto label = button->lifetime().make_state<QString>();
+	std::move(text) | rpl::on_next([=](QString value) {
+		*label = value;
+		button->update();
+	}, button->lifetime());
+	button->paintOn([=](QPainter &p) {
+		auto hq = PainterHighQualityEnabler(p);
+		const auto on = active && active();
+		const auto over = button->isOver();
+		const auto radius = button->height() / 2.;
+		auto fill = kButtonBg;
+		auto border = kPanelBorder;
+		auto ink = kText;
+		if (kind == ButtonKind::Primary) {
+			fill = on ? kRed : (over ? QColor(225, 225, 230) : kWhite);
+			border = fill;
+			ink = on ? kWhite : kInk;
+		} else if (kind == ButtonKind::Danger) {
+			fill = over ? QColor(170, 12, 36) : QColor(140, 8, 28);
+			border = kRed;
+			ink = kWhite;
+		} else {
+			fill = over ? kButtonOver : kButtonBg;
+			border = on ? kOrange : kPanelBorder;
+			ink = on ? kOrange : kText;
+		}
+		p.setPen(QPen(border, st::groupCallFightModeBorder));
+		p.setBrush(fill);
+		p.drawRoundedRect(
+			QRectF(button->rect()).adjusted(0.5, 0.5, -0.5, -0.5),
+			radius,
+			radius);
+		p.setPen(ink);
+		p.setFont(st::groupCallFightModeLabelFont->f);
+		p.drawText(button->rect(), Qt::AlignCenter, *label);
+	});
+	button->setClickedCallback(std::move(callback));
+	return button;
+}
+
+[[nodiscard]] SetValue AddRackSlider(
+		not_null<Ui::RpWidget*> parent,
+		const QRect &geometry,
+		const QString &title,
+		float64 current,
+		Fn<QString(float64)> format,
+		Fn<void(float64)> changed,
+		Fn<void()> finished) {
+	const auto row = Ui::CreateChild<Ui::RpWidget>(parent.get());
+	row->setGeometry(geometry);
+	const auto value = row->lifetime().make_state<float64>(current);
+	row->paintOn([=](QPainter &p) {
+		const auto titleRect = QRect(
+			0,
+			0,
+			row->width(),
+			st::groupCallFightModeRowTitleHeight);
+		p.setFont(st::groupCallFightModeLabelFont->f);
+		p.setPen(kText);
+		p.drawText(titleRect, Qt::AlignLeft | Qt::AlignVCenter, title);
+		p.setPen(kOrange);
+		p.drawText(
+			titleRect,
+			Qt::AlignRight | Qt::AlignVCenter,
+			format(*value));
+	});
+	const auto slider = Ui::CreateChild<Ui::MediaSlider>(
+		row,
+		st::groupCallFightModeSlider);
+	slider->setGeometry(
+		0,
+		st::groupCallFightModeSliderTop,
+		geometry.width(),
+		st::groupCallFightModeSlider.seekSize.height());
+	slider->setAlwaysDisplayMarker(true);
+	slider->setValue(current);
+	slider->setColorOverrides({
+		.activeFg = kRed,
+		.seekFg = kWhite,
+		.inactiveFg = kTrack,
+	});
+	slider->setChangeProgressCallback([=](float64 progress) {
+		*value = progress;
+		row->update();
+		changed(progress);
+	});
+	slider->setChangeFinishedCallback([=](float64 progress) {
+		*value = progress;
+		row->update();
+		changed(progress);
+		finished();
+	});
+	return [=](float64 progress) {
+		*value = progress;
+		slider->setValue(progress);
+		row->update();
+	};
+}
